<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#9EC6F3">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:layout_marginTop="80dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="450dp"
        android:layout_height="1050dp"
        android:layout_marginTop="30dp"
        android:padding="25dp"
        app:cardCornerRadius="70dp">

        <!-- ✅ Single child inside CardView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_marginTop="25dp"
                android:text="Forgot Password"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:layout_marginTop="30dp"
                android:text="Email" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="350dp"
                android:layout_height="45dp"
                android:layout_marginStart="55dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/rounded_input_field"
                android:hint="example@example.com"
                android:inputType="textEmailAddress"
                android:paddingStart="15dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <Button
                android:id="@+id/button_code"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="100dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/rounded_blue_button"
                android:text="Send Code" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginStart="85dp"
                android:text="Password Successfully Changed?" />

            <TextView
                android:id="@+id/forgot_go_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:layout_marginStart="300dp"
                android:text="Log In"
                android:textColor="@color/blu" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
