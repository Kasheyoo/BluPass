<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".ProfileActivity">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#7DB8E1"
        android:gravity="center"
        android:orientation="vertical" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Profile Picture -->
            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/person"
                android:background="@drawable/circle_white_bg"
                android:padding="10dp"/>

            <!-- Name -->
            <EditText
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Warren V. Gallardo"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:textColor="#000000"/>

            <!-- Personal Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_box"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"
                    android:textColor="#000000"/>

                <EditText
                    android:id="@+id/profileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Warren@gmail.com"
                    android:textColor="#555555"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/profilePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+63 912 345 6789"
                    android:textColor="#555555"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_box"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BLE UUID"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"
                    android:textColor="#000000"/>

                <EditText
                    android:id="@+id/bleUUID"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ASDFGC123456"
                    android:textColor="#555555"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- Vehicle Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_box"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vehicle Information"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"
                    android:textColor="#000000"/>

                <EditText
                    android:id="@+id/profilePlate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plate Number: ABC 123"
                    android:textColor="#555555"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/profileCar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Car Model: 2022 Toyota Camry"
                    android:textColor="#555555"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Security Section -->
            <!-- Security Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_box"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Security"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="4dp"/>

                <!-- Change Password trigger -->
                <TextView
                    android:id="@+id/changePasswordText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Password"
                    android:textColor="#00BFA5"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"
                    android:layout_gravity="end" />

                <!-- Hidden Password Field + Save Button -->
                <LinearLayout
                    android:id="@+id/passwordContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/profilePassword"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Enter new password"
                        android:inputType="textPassword"
                        android:background="@drawable/rounded_input_field"
                        android:padding="10dp"
                        android:textColor="#000000"
                        android:textColorHint="#A0A0A0"/>

                    <Button
                        android:id="@+id/btnSavePassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#7DB8E1"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>


            <!-- Notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_box"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Push Notifications"
                    android:textColor="#000000"
                    android:textSize="13sp"/>

                <Switch
                    android:id="@+id/switchPush"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:textOff="Off"
                    android:textOn="On"/>

            </LinearLayout>

            <!-- Buttons -->
            <Button
                android:id="@+id/btnEdit"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:layout_marginTop="16dp"
                android:backgroundTint="#7DB8E1"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Log Out"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E57373"/>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#7DB8E1"
        android:gravity="center">

        <ImageButton
            android:id="@+id/home"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:src="@drawable/home_logo"
            android:background="@android:color/transparent"
            android:contentDescription="Home"/>

        <ImageButton
            android:id="@+id/guest_access"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:src="@drawable/key_logo"
            android:background="@android:color/transparent"
            android:contentDescription="Access"/>

        <ImageButton
            android:id="@+id/home_history"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:src="@drawable/history_logo"
            android:background="@android:color/transparent"
            android:contentDescription="History"/>

        <ImageButton
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:src="@drawable/account_logo"
            android:background="@android:color/transparent"
            android:contentDescription="Profile"/>
    </LinearLayout>
</LinearLayout>
