<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#9EC6F3"
    android:gravity="bottom"
    tools:context=".RegisterActivity">

<View
 android:layout_width="match_parent"
 android:layout_height="90dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/rounded_white_container"
        android:padding="25dp"
        android:elevation="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#1C2C23"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="#1C2C23"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Username"
            android:background="@drawable/rounded_input_field"
            android:paddingStart="15dp"
            android:textColor="#000000"
            android:textColorHint="#A0A0A0"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#1C2C23"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Email"
            android:background="@drawable/rounded_input_field"
            android:paddingStart="15dp"
            android:textColor="#000000"
            android:textColorHint="#A0A0A0"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile Number"
            android:textColor="#1C2C23"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etMobile"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="+ 123 456 789"
            android:background="@drawable/rounded_input_field"
            android:paddingStart="15dp"
            android:inputType="phone"
            android:textColor="#000000"
            android:textColorHint="#A0A0A0"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date Of Birth"
            android:textColor="#1C2C23"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etDOB"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Select Date of Birth"
            android:background="@drawable/rounded_input_field"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:textColor="#000000"
            android:textColorHint="#A0A0A0"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="#1C2C23"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="••••••••"
            android:background="@drawable/rounded_input_field"
            android:paddingStart="15dp"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#A0A0A0"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Password"
            android:textColor="#1C2C23"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="••••••••"
            android:background="@drawable/rounded_input_field"
            android:paddingStart="15dp"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#A0A0A0"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="By continuing, you agree to Terms of Use and Privacy Policy."
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#1C2C23"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSignUp"
            android:layout_width="170dp"
            android:layout_height="45dp"
            android:text="Sign Up"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:background="@drawable/rounded_blue_button"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLoginLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Already have an account? Log In"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="#1C2C23"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</LinearLayout>
