<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".GuestAccessActivity">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#7EB8E6" />

        <!-- Content area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top container with invite button -->
            <LinearLayout
                android:id="@+id/guestContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/container_background"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Guest Access"
                        android:textColor="#000"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/inviteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#5CB85C"
                        android:text="Invite Guest"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Invite guests with temporary access codes"
                    android:textSize="10sp"
                    android:textColor="#555"
                    android:layout_marginTop="-14dp" />
            </LinearLayout>

            <!-- Scrollable guest list -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/guestListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Bottom Navigation -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:background="@drawable/bottom_nav_shape"
            android:gravity="center"
            android:paddingHorizontal="20dp">

            <ImageButton
                android:id="@+id/home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/home_logo"
                android:background="@android:color/transparent"
                android:contentDescription="Home"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/guest_access"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/key_logo"
                android:background="@android:color/transparent"
                android:contentDescription="Key"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/home_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/history_logo"
                android:background="@android:color/transparent"
                android:contentDescription="History"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/account_logo"
                android:background="@android:color/transparent"
                android:contentDescription="Profile"
                android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay popup -->
    <LinearLayout
        android:id="@+id/codeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false">

        <LinearLayout
            android:id="@+id/codeCard"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/guest_card"
            android:elevation="8dp">

            <TextView
                android:id="@+id/codeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code for Guest"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:layout_gravity="center_horizontal" />

            <!-- Guest name input -->
            <EditText
                android:id="@+id/guestNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Guest Name"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="@drawable/container_background"
                android:textColor="#000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/generatedCodeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="000000"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5CB85C"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal" />

            <Button
                android:id="@+id/okButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK"
                android:textColor="#FFF"
                android:backgroundTint="#5CB85C"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:paddingHorizontal="20dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
