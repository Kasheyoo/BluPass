<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".HomeActivity">

    <View
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#7EB8E6" />

    <LinearLayout
        android:id="@+id/statsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textSize="12sp"
                android:textColor="#555" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Guests"
                android:textSize="12sp"
                android:textColor="#555" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/card_background">

            <TextView
                android:id="@+id/gateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Closed"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gate Status"
                android:textSize="12sp"
                android:textColor="#555" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wifiCircle"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="32dp"
        android:layout_gravity="center"
        android:background="@drawable/circle_shape"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/wifi_logo"
            android:contentDescription="Wi-Fi" />
    </LinearLayout>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="One-Tap Gate Access"
        android:textStyle="bold"
        android:textSize="25sp"
        android:textColor="#003322" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:text="Status: Connected"
        android:textSize="14sp"
        android:textColor="#000" />

    <Button
        android:id="@+id/openGateButton"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="Open Gate"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7EB8E6" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@drawable/bottom_nav_shape"
        android:gravity="center"
        android:paddingHorizontal="20dp">

        <ImageButton
            android:id="@+id/home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/home_logo"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/guest_access"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/key_logo"
            android:background="@android:color/transparent"
            android:contentDescription="Key"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/home_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/history_logo"
            android:background="@android:color/transparent"
            android:contentDescription="History"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/account_logo"
            android:background="@android:color/transparent"
            android:contentDescription="Account"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
